{
  "name": "What Did I Miss?",
  "short_name": "Missed?",
  "description": "Catch up on overwhelming group chats in seconds. Private, on-device AI.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#15100f",
  "theme_color": "#15100f",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "chat",
          "accept": ["text/plain", ".txt", "application/zip", "application/x-zip-compressed", ".zip", "text/*"]
        }
      ]
    }
  }
}
